# CRM Pro Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String
# Defaults to local MongoDB or MongoDB Atlas URI:
# e.g., mongodb://localhost:27017/crm_pro or mongodb+srv://<user>:<password>@cluster.mongodb.net/crm_pro
MONGO_URI=mongodb://127.0.0.1:27017/crm_pro

# JWT Secret & Expiration
JWT_SECRET=crm_pro_super_secret_jwt_key_2026_enterprise_saas
JWT_EXPIRE=30d

# Client URL for CORS
CLIENT_URL=http://localhost:3000

